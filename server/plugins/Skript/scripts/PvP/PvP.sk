
function clearPvP(p: player):
    set {_name} to name of {_p}
    loop {pvp::enemies::%{_name}%::*}:
        set {_enemy} to loop-value
        remove {_name} from {pvp::enemies::%{_enemy}%::*}
    delete {pvp::enemies::%{_name}%::*}
    delete {pvp::time::%{_name}%}
    delete {pvp::enemy::%{_name}%}
    remove {_name} from {pvp::inpvp::*}

on damage:
    victim is a player
    attacker is a player
    attacker is not victim
    set {_v} to name of victim
    set {_a} to name of attacker
    set {pvp::time::%{_a}%} to now + 15 seconds
    set {pvp::time::%{_v}%} to now + 15 seconds
    if {pvp::inpvp::*} does not contain {_a}:
        add {_a} to {pvp::inpvp::*}
    if {pvp::inpvp::*} does not contain {_v}:
        add {_v} to {pvp::inpvp::*}
    if {pvp::enemies::%{_v}%::*} does not contain {_a}:
        send "<#ff0000>&lPvP&r &8» <#ff0000>You have been attacked by &e%{_a}%<#ff0000>! Do not log off!" to victim
    if {pvp::enemies::%{_a}%::*} does not contain {_v}:
        send "<#ff0000>&lPvP&r &8» <#ff0000>You attacked &e%{_v}%<#ff0000>! Do not log off!" to attacker
    if {pvp::enemies::%{_a}%::*} does not contain {_v}:
        add {_v} to {pvp::enemies::%{_a}%::*}
    if {pvp::enemies::%{_v}%::*} does not contain {_a}:
        add {_a} to {pvp::enemies::%{_v}%::*}
    set {pvp::enemy::%{_a}%} to {_v}
    set {pvp::enemy::%{_v}%} to {_a}

every 4 ticks:
    loop {pvp::inpvp::*}:
        set {_name} to loop-value
        delete {_p}
        delete {_e}
        loop all players:
            if name of loop-player is {_name}:
                set {_p} to loop-player
                stop loop
        if {_p} is not set:
            loop {pvp::enemies::%{_name}%::*}:
                remove {_name} from {pvp::enemies::%loop-value-2%::*}
            delete {pvp::enemies::%{_name}%::*}
            delete {pvp::time::%{_name}%}
            delete {pvp::enemy::%{_name}%}
            remove {_name} from {pvp::inpvp::*}
            continue
        set {_t} to {pvp::time::%{_name}%}
        if {_t} is not set:
            clearPvP({_p})
            continue
        if now >= {_t}:
            clearPvP({_p})
            send action bar "&aYou're no longer in combat!" to {_p}
            continue
        set {_remaining} to difference between {_t} and now
        set {_filled} to ceiling({_remaining} / 1 second)
        if {_filled} > 15:
            set {_filled} to 15
        set {_bar::*} to "&r<gradient:#ff0000:#990000>"
        loop {_filled} - 1 times:
            add "|" to {_bar::*}
        add "&l|</gradient>&r&7" to {_bar::*}
        loop 15 - {_filled} times:
            add "|" to {_bar::*}
        set {_bar} to join {_bar::*} with ""
        set {_enemyName} to {pvp::enemy::%{_name}%}
        loop all players:
            if name of loop-player is {_enemyName}:
                set {_e} to loop-player
                stop loop
        loop all npcs:
            if name of loop-npcs is {_enemyName}:
                set {_e} to loop-npcs
                stop loop
        if {_e} is not set:
            loop {pvp::enemies::%{_name}%::*}:
                set {_search} to loop-value-1
                loop all players:
                    if name of loop-player is {_search}:
                        set {_e} to loop-player
                        stop loop
                if {_e} is set:
                    stop loop
        if {_e} is not set:
            send action bar "<#ff0000>In combat! &7| &r&7&l[ %{_bar}% &r&7&l]" to {_p}
            continue
        set {_totemcount} to amount of totem of undying in {_e}'s inventory
        if {_totemcount} > 0:
            set {_totems} to " &a%{_totemcount}%"
        else:
            set {_totems} to ""
        if {_e}'s absorption amount > 0:
            send action bar "&r<gradient:#ff0000:#990000>%name of {_e}%: %health of {_e}% ❤</gradient> &6%{_e}'s absorption amount / 2%%{_totems}%&r&7 | &r&7&l[ %{_bar}% &r&7&l]" to {_p}
        else:
            send action bar "&r<gradient:#ff0000:#990000>%name of {_e}%: %health of {_e}% ❤</gradient>%{_totems}%&r&7 | &r&7&l[ %{_bar}% &r&7&l]" to {_p}

on quit:
    if {pvp::inpvp::*} contains player's name:
        kill player
        broadcast "<#ff0000>&lPvP&r &8» <#ff0000>&e%player%<#ff0000> tried to escape combat!"
        clearPvP(player)

on death:
    victim is a player
    if attacker is a player:
        send action bar "&aYou've killed %name of victim%!" to attacker
    clearPvP(victim)
    clearPvP(attacker)

on command:
    if player is not set:
        stop
    if {pvp::inpvp::*} contains player's name:
        if {pvp::allowedcmds::*} does not contain command:
            if player is "EntityZ096x":
                stop
            cancel event
            send "<#ff0000>&lPvP&r &8» <#ff0000>You cannot use %command% while in combat!" to player

on load:
    delete {pvp::allowedcmds::*}
    add "suicide" to {pvp::allowedcmds::*}
    add "msg" to {pvp::allowedcmds::*}
