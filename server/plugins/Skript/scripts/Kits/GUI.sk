function kitGUI(p: player):
    open chest inventory with 3 rows named "&8Kit Menu" to {_p}
    loop 27 times:
        set slot (loop-number - 1) of {_p}'s current inventory to gray stained glass pane named " "
    set slot 10 of {_p}'s current inventory to chest named "&a&lLOAD KIT" with lore "&7Click to load a kit."
    set slot 12 of {_p}'s current inventory to chest named "&e&lSAVE KIT" with lore "&7Click to save your current inventory."
    set slot 14 of {_p}'s current inventory to lava bucket named "&c&lDELETE KIT" with lore "&7Click to delete a kit."
    set slot 16 of {_p}'s current inventory to name tag named "&b&lEDIT ICONS" with lore "&7Change your kit icons and glow."
    set slot 22 of {_p}'s current inventory to crafting table named "&d&lKIT LAYOUTS" with lore "&7Edit your kit layouts."

function kitLoadGUI(p: player):
    open chest inventory with 6 rows named "&8Load Kit" to {_p}
    loop 54 times:
        set slot (loop-number - 1) of {_p}'s current inventory to gray stained glass pane named " "
    set {_slot} to 10
    loop {kits::*}:
        set {_kit} to loop-value
        set {_icon} to {kit::%{_kit}%::icon}
        if {_icon} is not set:
            set {_icon} to chest
            set {kit::%{_kit}%::icon} to chest
        if {kit::%{_kit}%::glow} is true:
            enchant {_icon} with unbreaking 1
            add hide enchants to item flags of {_icon}
        set {_display} to {_icon}
        set name of {_display} to "&a&l%{_kit}%"
        set lore of {_display} to "&7Click to load this kit."
        set slot {_slot} of {_p}'s current inventory to {_display}
        add 1 to {_slot}
        if {_slot} is 44:
            stop loop
    set slot 49 of {_p}'s current inventory to barrier named "&c&lBACK"

function kitDeleteGUI(p: player):
    open chest inventory with 6 rows named "&8Delete Kit" to {_p}
    loop 54 times:
        set slot (loop-number - 1) of {_p}'s current inventory to gray stained glass pane named " "
    set {_slot} to 10
    loop {kits::*}:
        set {_kit} to loop-value
        set {_icon} to {kit::%{_kit}%::icon}
        if {_icon} is not set:
            set {_icon} to chest
        if {kit::%{_kit}%::glow} is true:
            enchant {_icon} with unbreaking 1
            add hide enchants to item flags of {_icon}
        set {_display} to {_icon}
        set name of {_display} to "&c&l%{_kit}%"
        set lore of {_display} to "&7Click to delete this kit."
        set slot {_slot} of {_p}'s current inventory to {_display}
        add 1 to {_slot}
        if {_slot} is 44:
            stop loop
    set slot 49 of {_p}'s current inventory to barrier named "&c&lBACK"

function kitDeleteConfirmGUI(p: player):
    set {_kit} to {kitdelete::%{_p}%}
    open chest inventory with 3 rows named "&8Delete &c%{_kit}%" to {_p}
    loop 27 times:
        set slot (loop-number - 1) of {_p}'s current inventory to gray stained glass pane named " "
    set {_icon} to {kit::%{_kit}%::icon}
    if {_icon} is not set:
        set {_icon} to chest
    if {kit::%{_kit}%::glow} is true:
        enchant {_icon} with unbreaking 1
        add hide enchants to item flags of {_icon}
    set slot 13 of {_p}'s current inventory to {_icon} named "&e&l%{_kit}%" with lore "&7Are you sure you want to delete this kit?"
    set slot 11 of {_p}'s current inventory to red wool named "&c&lDELETE" with lore "&7Permanently delete &e%{_kit}%&7."
    set slot 15 of {_p}'s current inventory to lime wool named "&a&lCANCEL" with lore "&7Go back."

function kitLayoutGUI(p: player):
    open chest inventory with 6 rows named "&8Kit Layouts" to {_p}
    loop 54 times:
        set slot (loop-number - 1) of {_p}'s current inventory to gray stained glass pane named " "
    set {_slot} to 10
    loop {kits::*}:
        set {_kit} to loop-value
        set {_icon} to {kit::%{_kit}%::icon}
        if {_icon} is not set:
            set {_icon} to chest
        if {kit::%{_kit}%::glow} is true:
            enchant {_icon} with unbreaking 1
            add hide enchants to item flags of {_icon}
        set {_display} to {_icon}
        set name of {_display} to "&b&l%{_kit}%"
        set lore of {_display} to "&7Click to edit this layout."
        set slot {_slot} of {_p}'s current inventory to {_display}
