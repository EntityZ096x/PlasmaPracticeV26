# =========================================================
# CLICK
# =========================================================

on inventory click:
    if name of event-inventory contains "&8Edit Layout: ":

        # SAVE
        if event-slot is 49:
            cancel event

            set {_kit} to {kiteditor::%player%::kit}

            delete {kitlayout::%player%::%{_kit}%::*}

            # Check every editable GUI slot
            loop 41 times:
                set {_item} to slot (loop-number - 1) of event-inventory

                if {_item} is not air:

                    # Search lore for Parent Slot
                    loop lore of {_item}:
                        if loop-value-2 contains "&8Parent Slot:":

                            set {_parts::*} to split loop-value-2 at ": "
                            set {_source} to last element of {_parts::*}

                            # Destination -> Original source
                            set {kitlayout::%player%::%{_kit}%::%loop-number%} to {_source}

            delete {kiteditor::%player%::*}
            close player's inventory

            send "&aYour &e%{_kit}% &akit layout has been saved!"
            stop


        # CANCEL
        if event-slot is 53:
            cancel event

            delete {kiteditor::%player%::*}
            close player's inventory

            send "&cKit layout editing cancelled!"
            stop


        # Prevent bottom row
        if event-slot >= 41:
            cancel event
            stop


# =========================================================
# DRAG
# =========================================================

on inventory drag:
    if name of event-inventory contains "&8Edit Layout: ":
        loop event-slots:
            if loop-value >= 41:
                cancel event
                stop


# =========================================================
# CLOSE WITHOUT SAVING
# =========================================================

on inventory close:
    if name of event-inventory contains "&8Edit Layout: ":
        if {kiteditor::%player%::kit} is set:
            delete {kiteditor::%player%::*}
            send "&cKit layout editing cancelled!"

on leave:
    if {kiteditor::%player%::kit} is set:
        delete {kiteditor::%player%::*}
        send "&cKit layout editing cancelled!"

on death:
    if {kiteditor::%victim%::kit} is set:
        delete {kiteditor::%victim%::*}
        send "&cKit layout editing cancelled!" to victim