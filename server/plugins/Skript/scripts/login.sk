on join:
    teleport player to location(0.5, 64, 0.5, world "voidworld")
    set player's walk speed to 0
    set player's gamemode to spectator

    set {login.timer.%player%} to 60

    if {login.password.%player%} is set:
        send title "&r&l&o<gradient:#941800:#ff0000>Plasma</gradient><gradient:#A3A3A3:#666666>Network</gradient>" with subtitle "&r&7Use <#ff0000>/login <password>." to player for 999 seconds
    else:
        send title "&r&l&o<gradient:#941800:#ff0000>Plasma</gradient><gradient:#A3A3A3:#666666>Network</gradient>" with subtitle "&r&7Use <#ff0000>/register <password> <confirm>." to player for 999 seconds

    while {login.timer.%player%} > 0:

        send action bar "&r&7You have <#ff0000>%{login.timer.%player%}%s<reset>&7 to login/register" to player
        wait 1 second
        

        if {login.timer.%player%} is set:
            if {login.timer.%player%} is not "logged":
                remove 1 from {login.timer.%player%}

    wait 1 tick
    if {login.timer.%player%} is "logged":
        delete {login.timer.%player%}
        execute player command "/lobby"
        set player's walk speed to 0.2
        send action bar "&r&aYou have succesfully logged in." to player
        set player's gamemode to survival
        stop

    delete {login.timer.%player%}
    send action bar "" to player
    kick player due to "<#ff0000>You took too long to login/register!"


on quit:
    delete {login.timer.%player%}


command /login [<text>]:
    aliases: /l
    trigger:
        if {login.timer.%player%} is not set:
            send "<#ff0000>You're already logged in." to player
            stop

        if {login.password.%player%} is not set:
            send "&r&7Use <#ff0000>/register <password> <confirm>&r&7 to set a password first."
            stop

        if arg-1 is not set:
            send "<#ff0000>Please type your password." to player
            stop

        if arg-1 is {login.password.%player%}:
            set {login.timer.%player%} to "logged"
            send action bar "&r&aYou have succesfully logged in." to player
            send title "" with subtitle "&r&aYou've successfully logged in." to player for 1 second
        else:
            kick player due to "<#ff0000>Incorrect password."


command /register [<text>] [<text>]:
    aliases: /r
    trigger:
        if {login.timer.%player%} is not set:
            send "<#ff0000>You're already logged in." to player
            stop

        if {login.password.%player%} is set:
            send "&r&7Use <#ff0000>/login <password>&r&7 as you've already set a password."
            send "&r&7To change it, use <#ff0000>/changepass <password> <confirm>&r&7."
            stop

        if arg-1 is not set:
            send "<#ff0000>Please type a password." to player
            stop

        if arg-2 is not set:
            send "<#ff0000>Please confirm your password." to player
            stop

        if arg-1 is arg-2:
            set {login.timer.%player%} to "logged"
            set {login.password.%player%} to arg-1
            send action bar "&r&aYou have succesfully registered." to player
            send title "" with subtitle "&r&aYou've successfully registered." to player for 1 second
        else:
            send "<#ff0000>Please confirm your password correctly."


command /changepass [<text>] [<text>]:
    aliases: /cp
    trigger:
        if {login.timer.%player%} is set:
            send "<#ff0000>You must be logged in to change your password." to player
            stop

        if arg-1 is not set:
            send "<#ff0000>Please type a password." to player
            stop

        if arg-2 is not set:
            send "<#ff0000>Please confirm your password." to player
            stop

        if arg-1 is arg-2:
            set {login.password.%player%} to arg-1
            send title "" with subtitle "&r&aYou've successfully changed your password." to player for 1 second
        else:
            send "<#ff0000>Please confirm your password correctly."


on command:
    if {login.timer.%player%} is set:
        if command is not "login" or "l" or "register" or "r":
            cancel event
            send "<#ff0000>Login/register first." to player

on chat:
    if {login.timer.%player%} is set:
        cancel event
        send "<#ff0000>Login/register first." to player