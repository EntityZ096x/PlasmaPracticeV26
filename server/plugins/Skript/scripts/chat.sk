import:
    com.viaversion.viaversion.api.Via

on join:
    set {protocol::%player%} to Via.getAPI().getPlayerVersion(player)

    if {protocol::%player%} < 774:
        set {_msg} to text component from "&7[&a+&7] &e%player%"
        set {_hover} to text component from "&eThis player is on an outdated client."
        set {_event} to a new hover event showing {_hover}
        set hover event of {_msg} to {_event}
        set join message to {_msg}
    else:
        set join message to "&7[&a+&7] &f%player%"

on quit:
    set the quit message to "&r&7[&r&c-&r&7] &r&e%player%"



on chat:
    if player's name is "ustDan12":
        set message to lowercase message
        set message to "%message%~ %random element out of "uwu", "nya", "*purr*"%~!"
        replace all " yo ", " hi ", " hello ", " helo " in message with "%random element out of " hiii ", " heyy ", " hewo "%"
        loop all players:
            replace all "%loop-player's name%" in message with "master"
        replace all "r" in message with "w"
        replace all "l" in message with "w"
        replace all "o" in message with "u"
    set chat format to "%player's prefix%%player's name%%player's suffix% &r&8» &r%message%"


on death:
    if attacker's tool is a mace:
        attacker's fall distance > 2
        add "Ahhh~~~~" to {_deathMessages::*}
        add "It's so big!~" to {_deathMessages::*}
        add "euhhhh~~" to {_deathMessages::*}
        add "Harder daddy~!" to {_deathMessages::*}
        add "It's so hard!~" to {_deathMessages::*}
        add "*MOAN*" to {_deathMessages::*}
        
        set {_deathMessage} to random element out of {_deathMessages::*}
        make victim say {_deathMessage}
        set {_msg} to text component from "SMASHED"
        set {_hover} to text component from "&fIf you're reading this, use /code diddled for 100 prisms!"
        set {_event} to a new hover event showing {_hover}
        set hover event of {_msg} to {_event}
        set death message to "%victim% was %{_msg}% by %attacker%"

        
    if attacker's tool's name is "&r&f50 Calibre Sniper Rifle":
        set death message to "%victim% got sniped by %attacker%."

command /makesay <player> <text>:
    trigger:
        make arg-1 say arg-2

command /t <text>:
    trigger:
        if sender is not console:
            stop
        set {_a} to arg-1
        replace all ":hakenkruis:" with "卐" in {_a}
        broadcast "&r&cEntityZ096x (as console)&r: %{_a}%"

command /protocol:
    trigger:
        send {protocol::%player%} to player