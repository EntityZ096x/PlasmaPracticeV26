on resurrect attempt:
    wait 1 tick
    if player's inventory contains totem of undying:
        if player's offhand item is air:
            if {hax.instatotem.%player%} is "enabled":
                remove 1 of totem of undying from player's inventory
                set player's offhand item to totem of undying

on damage:
    if attacker's tool is mace:
        if gliding of attacker is true:
            if {hax.elytramace.%attacker%} is "enabled":
                set gliding of attacker to false
                wait 1 tick
                set gliding of attacker to true

on damage:
    if attacker's tool is mace:
        if {hax.alwaysslam.%attacker%} is "enabled":
            if gliding of attacker is true:
                set gliding of attacker to false
            if attacker's fall distance < 2:
                set attacker's fall distance to 2
            if victim's tool is a shield:
                cancel event
                delete {hax.alwaysslam.%attacker%}
                set attacker's current hotbar slot to 1
                make attacker attack victim
                wait 1 tick
                set attacker's current hotbar slot to 0
                if attacker's fall distance < 2:
                    set attacker's fall distance to 2
                make attacker attack victim
                wait 1 tick
                set {hax.alwaysslam.%attacker%} to "enabled"

every 10 ticks:
    loop all players:
        if {hax.xray.%loop-player%} is true:
            loop blocks in radius 16 around loop-player:
                if loop-block is diamond ore or deepslate diamond ore:
                    draw 8 particles of dust using dustOption(rgb(0, 255, 255), 1) at loop-block
                else if loop-block is ancient debris:
                    draw 8 particles of dust using dustOption(rgb(255, 80, 0), 1) at loop-block
                else if loop-block is emerald ore or deepslate emerald ore:
                    draw 8 particles of dust using dustOption(rgb(0, 255, 0), 1) at loop-block
                else if loop-block is gold ore or deepslate gold ore:
                    draw 8 particles of dust using dustOption(rgb(255, 215, 0), 1) at loop-block
                else if loop-block is iron ore or deepslate iron ore:
                    draw 8 particles of dust using dustOption(rgb(200, 200, 200), 1) at loop-block
                else if loop-block is redstone ore or deepslate redstone ore:
                    draw 8 particles of dust using dustOption(rgb(255, 0, 0), 1) at loop-block
                else if loop-block is lapis ore or deepslate lapis ore:
                    draw 8 particles of dust using dustOption(rgb(0, 80, 255), 1) at loop-block