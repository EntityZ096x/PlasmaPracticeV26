every 10 ticks:
    loop all entities:
        if loop-entity's display name is "&8&lBedrock Skeleton":
            loop all players in radius 30 around loop-entity:
                make loop-entity-1 look at loop-player
                wait 1 tick
                shoot a arrow from loop-entity-1
                push last spawned arrow in direction of loop-entity-1 at speed 1000

on projectile hit: 
    if shooter's display name is "&8&lBedrock Skeleton":
        delete the projectile
        create an explosion of force 0 at the projectile

on damage:
    if attacker's display name is "&8&lBedrock Skeleton":
        set damage to 30
        

command /boss:
    trigger:
        summon a skeleton at player
        set {_m} to last spawned skeleton
        set {_m}'s tool to a bow named "&r&l180 Calibre Sniper Rifle"
        set {_m}'s display name to "&8&lBedrock Skeleton" 
        set {_a} to netherite helmet
        enchant {_a} with protection 6
        enchant {_a} with feather falling 6
        set {_m}'s helmet to {_a}
        set {_a} to netherite chestplate
        enchant {_a} with protection 6
        enchant {_a} with feather falling 6
        set {_m}'s chestplate to {_a}
        
