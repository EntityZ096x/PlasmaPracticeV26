on load:
    delete {orbitalperms::*}
    add "EntityZ096x" to {orbitalperms::*}
    add "Clstial" to {orbitalperms::*}
    add "QuantumEcho" to {orbitalperms::*}
    add "JustDan12" to {orbitalperms::*}

command /orbital <player> [<text>]:
    trigger:
        if {orbitalperms::*} does not contain player's name:
            if sender is not console:
                stop
        Orbital(arg-1's location, arg-2, player)

function Orbital(l: location, type: text, p: player):
    if {_type} is "stab":
        set y-coordinate of {_l} to 319
        loop 383 times:
            if block at {_l} is bedrock, obsidian, water, respawn anchor:
                stop
            add -1 to y-coordinate of {_l}
            create an explosion of force 4 at {_l}

            loop all entities in radius 4 around {_l}:
                damage loop-entity by 50 hearts


    else if {_type} is "nuke":
        add 40 to y-coordinate of {_l}
        set {_speed} to 0

        loop 9 times:
            set {_amount} to {_speed} * 50 + 1
            set {_angle} to 0

            loop {_amount} times:
                summon primed tnt at {_l}
                set {_tnt} to last spawned entity
                set metadata value "orbital" of {_tnt} to true

                set {_angle} to 360 / {_amount} + {_angle}
                set {_x} to cos({_angle}) * {_speed}
                set {_z} to sin({_angle}) * {_speed}

                set velocity of {_tnt} to vector({_x}, 0, {_z})

            add 0.26 * 0.8 to {_speed}

    else if {_type} is "stabarrow":
        add 50 to y position of {_l}
        loop 3 times:
            loop 50 times:
                set {_o} to {_l}
                add a random number between -2 and 2 to x-coordinate of {_o}
                add a random number between -2 and 2 to z-coordinate of {_o}
                spawn an arrow at {_o}
                push the last spawned arrow downwards at speed 250
            wait 1 ticks


    send "%{_p}% sent a %{_type}% shot at %{_l}%" to console

on damage:
    if metadata value "orbital" of attacker is true:
        set damage to 33

command /orbitalrod <player> <text>:
    trigger:
        set {_m} to fishing rod named "Orbital %arg-2% shot"
        set lore of {_m} to arg-2
        set durability of {_m} to 0
        give arg-1 {_m}

on fishing line cast:
    if {orbitalperms::*} does not contain player's name:
        stop

    set {_t::*} to player's tool's lore
    set {_t} to {_t::1}

    if {_t} is "nuke":
        set player's tool to air
        Orbital(player's target block's location, {_t}, player)
    else if {_t} is "stab":
        set player's tool to air
        Orbital(player's target block's location, {_t}, player)
    else if {_t} is "stabarrow":
        set player's tool to air
        Orbital(player's target block's location, {_t}, player)
    else if {_t} is "nukearrow":
        set player's tool to air
        Orbital(player's target block's location, {_t}, player)

