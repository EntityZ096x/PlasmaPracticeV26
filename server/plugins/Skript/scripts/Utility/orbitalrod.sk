on load:
    delete {orbitalperms::*}
    add "EntityZ096x" to {orbitalperms::*}
    add "JustDan12" to {orbitalperms::*}
    add "Clstial" to {orbitalperms::*}

command /orbital <player> [<text>]:
    trigger:
        if {orbitalperms::*} does not contain player's name:
            stop
        Orbital(arg-1's location, arg-2, player)

function Orbital(l: location, type: text, p: player):
    if {_type} is "stab":
        set y-coordinate of {_l} to -64
        loop 383 times:
            add 1 to y-coordinate of {_l}
            create an explosion of force 6 at {_l}

    else if {_type} is "nuke":
        add 50 to y-coordinate of {_l}
        set {_speed} to 0

        loop 7 times:
            set {_amount} to {_speed} * 50 + 1
            set {_angle} to 0

            loop {_amount} times:
                summon primed tnt at {_l}
                set {_tnt} to last spawned entity
                set metadata value "orbital" of {_tnt} to true

                set {_angle} to 360 / {_amount} + {_angle}
                set {_x} to cos({_angle}) * {_speed}
                set {_z} to sin({_angle}) * {_speed}

                set velocity of {_tnt} to vector({_x}, 0, {_z})

            add 0.26 * 1 to {_speed}

        send "%{_p}% sent a %{_type}% shot at %{_l}%" to console

on explosion:
    if metadata value "orbital" of event-entity is true:
        cancel event
        set {_pos} to location of event-entity
        delete event-entity
        create an explosion of force 6 at {_pos}

command /orbitalrod <player> <text>:
    trigger:
        set {_m} to fishing rod named "Orbital %arg-2% shot"
        set lore of {_m} to arg-2
        set durability of {_m} to 0
        give arg-1 {_m}

on fishing line cast:
    if {orbitalperms::*} does not contain player's name:
        stop

    set {_t::*} to player's tool's lore
    set {_t} to {_t::1}

    if {_t} is "nuke":
        set player's tool to air
        Orbital(player's target block's location, {_t}, player)
    else if {_t} is "stab":
        set player's tool to air
        Orbital(player's target block's location, {_t}, player)
