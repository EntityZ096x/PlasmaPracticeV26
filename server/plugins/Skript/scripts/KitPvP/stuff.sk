        set {_deathMessage} to random element out of {_deathMessages::*}
        send title "<#ff0000>&lYOU DIED!" with subtitle "&r&f%{_deathMessage}%" to victim

on right click:
    if player's tool is netherite sword:
        if name of player's tool is "&d&lSelect Kit":
            cancel event
            open chest inventory with 3 rows named "          &8» &d&lSelect Kit &8«" to player
            wait 1 tick

            loop 27 times:
                set slot (loop-number - 1) of player's current inventory to gray stained glass pane named " "

            set slot 11 of player's current inventory to mace named "&b&lMace" with lore "&7Left-Click to select this kit.", "&7Right-Click to edit layout"
            set slot 12 of player's current inventory to end crystal named "&b&lCrystal" with lore "&7Left-Click to select this kit.", "&7Right-Click to edit layout"
            set slot 13 of player's current inventory to netherite sword named "&b&lDefault" with lore "&7Left-Click to select this kit.", "&7Right-Click to edit layout"
            set slot 14 of player's current inventory to mace named "&b&lDueloMacestro" with lore "&7Left-Click to select this kit.", "&7Right-Click to edit layout"
            set slot 15 of player's current inventory to lime stained glass pane named "&a&lKit 5" with lore "&7Left-Click to select this kit.", "&7Right-Click to edit layout"

on inventory click:
    if name of player's current inventory is "          &8» &d&lSelect Kit &8«":
        cancel event
        if click type is left mouse button:
            if clicked slot is 11:
                set {KitPvP::kit::%player%} to "Mace"
                send "&r&aSelected the &eMace &aKit" to player
                close player's inventory
            if clicked slot is 12:
                set {KitPvP::kit::%player%} to "Crystal"
                send "&r&aSelected the &eCrystal &aKit" to player
                close player's inventory
            if clicked slot is 13:
                set {KitPvP::kit::%player%} to "Default"
                send "&r&aSelected the &eDefault &aKit" to player
                close player's inventory
            if clicked slot is 14:
                set {KitPvP::kit::%player%} to "DueloMacestro"
                send "&r&aSelected the &eDueloMacestro &aKit" to player
                close player's inventory
        if click type is right mouse button:
            if clicked slot is 11:
                execute player command "/kit layout edit Mace"
            if clicked slot is 12:
                execute player command "/kit layout edit Crystal"
            if clicked slot is 13:
                execute player command "/kit layout edit Default"
            if clicked slot is 14:
                execute player command "/kit layout edit DueloMacestro"
        