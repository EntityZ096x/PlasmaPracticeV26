on enter of region named "kitpvp_arena":
    if {KitPvP::kit::%player%} is not set:
        set {KitPvP::kit::%player%} to "UltraHardCore"
    set player's food level to 10
    set player's saturation to 10
    set player's health to 10
    execute console command "/kit load %{KitPvP::kit::%player%}% %player%"
    set {KitPvP::invincibility::%player%} to true
    set player's hotbar slot to 0
    wait 5 seconds
    delete {KitPvP::invincibility::%player%}

on damage:
    if {KitPvP::invincibility::%victim%} is set:
        delete {KitPvP::invincibility::%victim%}
        cancel event

on exit of region named "kitpvp_arena":
    if {AllowExitOfAreas::%player%} is true:
        delete {AllowExitOfAreas::%player%}
        stop
    delete {KitPvP::invincibility::%player%}
    cancel event

on damage:
    if attacker is a player:
        if region "kitpvp_spawn" in world of attacker contains attacker:
            cancel event

    if victim is a player:
        if region "kitpvp_spawn" in world of victim contains victim:
            cancel event

on enter of region named "kitpvp_spawn":
    clear player's inventory
    set slot 4 of player's inventory to a netherite sword named "&d&lSelect Kit"

on death:
    if region "kitpvp_arena" in world of victim contains victim:
        if attacker is set:
            add 1 to {KitPvP::killstreak::%attacker%}
            send "<gradient:#F54927:#FFD900>&lKitPvP</gradient> &r&8»&r <#ff0000>KILL! Your current killstreak: %{KitPvP::killstreak::%attacker%}%" to attacker
            send "<gradient:#F54927:#FFD900>&lKitPvP</gradient> &r&8»&r <#ff0000>You've been killed by %attacker%" to victim

            execute console command "/kit load %{KitPvP::kit::%attacker%}% %attacker%"
            
            set {KitPvP::killstreak::%victim%} to 0
        clear drops 
        force victim to respawn

        add "consider uninstalling" to {_deathMessages::*}
        add "the end" to {_deathMessages::*}
        add "how did u even win the sperm race vro" to {_deathMessages::*}
        add "holy shit that sucked" to {_deathMessages::*}
        add "Skill issue." to {_deathMessages::*}
        add "git gud" to {_deathMessages::*}
        add "stage 4 terminal skill issue" to {_deathMessages::*}
        add "my grandma better than u" to {_deathMessages::*}
        add "MUHHAHAHA" to {_deathMessages::*}
        add "ur trashhhh" to {_deathMessages::*}
        add "min aura" to {_deathMessages::*}
        add "NPC type shi" to {_deathMessages::*}
        add "free elo" to {_deathMessages::*}
        add "maybe try smth else?" to {_deathMessages::*}
        add "even the bots fight better" to {_deathMessages::*}
        add "cooked." to {_deathMessages::*}
        add "afk ahh" to {_deathMessages::*}
        add "consider uninstalling" to {_deathMessages::*}
        add "the end" to {_deathMessages::*}
        add "how did u even win the sperm race vro" to {_deathMessages::*}
        add "[ᴘʀᴏɢʀᴇss ᴅᴇᴛᴇᴄᴛᴇᴅ, ɪɴɪᴛɪᴀʟɪᴢɪɴɢ ᴘʀᴏᴛᴏᴄᴏʟ: ꜰᴜᴄᴋ ʏᴏᴜ]" to {_deathMessages::*}
        add "ur ahh" to {_deathMessages::*}
        add "death speedrun any%%" to {_deathMessages::*}
        add "ur pc deserves better" to {_deathMessages::*}
        add "LT6" to {_deathMessages::*}
        add "nigger" to {_deathMessages::*}
        add "sniped" to {_deathMessages::*}
        add "ts not tuff" to {_deathMessages::*}
        add "zero game sense" to {_deathMessages::*}
        add "bro had ONE job" to {_deathMessages::*}
        add "top 5 dumbest moments" to {_deathMessages::*}
        add "that's enough Minecraft for today" to {_deathMessages::*}
        
        set {_deathMessage} to random element out of {_deathMessages::*}
        send title "<#ff0000>&lYOU DIED!" with subtitle "&r&f%{_deathMessage}%" to victim

on right click:
    if player's tool is netherite sword:
        if name of player's tool is "&d&lSelect Kit":
            cancel event
            open chest inventory with 4 rows named "          &8» <gradient:#F54927:#FFD900>&lSelect Kit</gradient> &8«" to player
            wait 1 tick

            loop 54 times:
                set slot (loop-number - 1) of player's current inventory to gray stained glass pane named " "

            set slot 11 of player's current inventory to mace named "<gradient:#F54927:#FFD900>&lMace" with lore "&7Left-Click to select this kit.", "&7Right-Click to edit layout"
            set slot 12 of player's current inventory to end crystal named "<gradient:#F54927:#FFD900>&lCrystal" with lore "&7Left-Click to select this kit.", "&7Right-Click to edit layout"
            set slot 13 of player's current inventory to netherite sword named "<gradient:#F54927:#FFD900>&lUltraHardCore" with lore "&7Left-Click to select this kit.", "&7Right-Click to edit layout"
            set slot 14 of player's current inventory to redstone named "<gradient:#F54927:#FFD900>&lTrapper" with lore "&7Left-Click to select this kit.", "&7Right-Click to edit layout"
            set slot 15 of player's current inventory to minecart with tnt named "<gradient:#F54927:#FFD900>&lXBowCart" with lore "&7Left-Click to select this kit.", "&7Right-Click to edit layout"
            set slot 20 of player's current inventory to splash potion of healing named "<gradient:#F54927:#FFD900>&lUltraNoDebuff" with lore "&7Left-Click to select this kit.", "&7Right-Click to edit layout"
            set slot 21 of player's current inventory to mace with item model "heavy_mace" named "<gradient:#F54927:#FFD900>&lDueloMacestro" with lore "&7Left-Click to select this kit.", "&7Right-Click to edit layout"
            set slot 22 of player's current inventory to shears with item model "sniper_rifle" named "<gradient:#F54927:#FFD900>&lSniper" with lore "&7Left-Click to select this kit.", "&7Right-Click to edit layout"

on inventory click:
    if name of player's current inventory is "          &8» <gradient:#F54927:#FFD900>&lSelect Kit</gradient> &8«":
        cancel event
        if click type is left mouse button:
            if {KitPvP::enabledkitslots::*} contains clicked slot:
                set {KitPvP::kit::%player%} to uncolored event-item's name
                send "<gradient:#F54927:#FFD900>&lKitPvP</gradient> &r&8»&r &aSelected the kit &e%uncolored event-item's name%&a!"
                close player's inventory
        if click type is right mouse button:
            if {KitPvP::enabledkitslots::*} contains clicked slot:
                execute player command "/kit layout edit %uncolored event-item's name%"

on load:
    delete {KitPvP::enabledkitslots::*}
    add 11 to {KitPvP::enabledkitslots::*}
    add 12 to {KitPvP::enabledkitslots::*}
    add 13 to {KitPvP::enabledkitslots::*}
    add 14 to {KitPvP::enabledkitslots::*}
    add 15 to {KitPvP::enabledkitslots::*}
    add 20 to {KitPvP::enabledkitslots::*}
    add 21 to {KitPvP::enabledkitslots::*}
    add 22 to {KitPvP::enabledkitslots::*}
    
        