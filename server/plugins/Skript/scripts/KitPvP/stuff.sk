on enter of region named "kitpvp_arena":
    if {KitPvP::kit::%player%} is not set:
        set {KitPvP::kit::%player%} to "Default"
    execute console command "/kit load %{KitPvP::kit::%player%}% %player%"
    set {KitPvP::invincibility::%player%} to true
    wait 5 seconds
    delete {KitPvP::invincibility::%player%}

on damage:
    if {KitPvP::invincibility::%victim%} is set:
        delete {KitPvP::invincibility::%victim%}
        cancel event

on exit of region named "kitpvp_arena":
    cancel event

on damage:
    if attacker is a player:
        if region "kitpvp_spawn" in world of attacker contains attacker:
            cancel event

    if victim is a player:
        if region "kitpvp_spawn" in world of victim contains victim:
            cancel event

on enter of region named "kitpvp_spawn":
    clear player's inventory
    set slot 4 of player's inventory to a netherite sword named "&d&lSelect Kit"

on death:
    if region "kitpvp_arena" in world of victim contains victim:
        if attacker is set:
            add 1 to {KitPvP::killstreak::%attacker%}
            send "<gradient:#F54927:#FFD900>&lKitPvP</gradient> &r&8»&r <#ff0000>KILL! Your current killstreak: %{KitPvP::killstreak::%attacker%}%" to attacker
            send "<gradient:#F54927:#FFD900>&lKitPvP</gradient> &r&8»&r <#ff0000>You've been killed by %attacker%" to victim

            execute console command "/kit load %{KitPvP::kit::%attacker%}% %attacker%"
            
            set {KitPvP::killstreak::%victim%} to 0
        force victim to respawn

        add "Skill issue." to {_deathMessages::*}
        add "git gud" to {_deathMessages::*}
        add "stage 4 terminal skill issue" to {_deathMessages::*}
        add "my grandma better than u" to {_deathMessages::*}
        add "MUHHAHAHA" to {_deathMessages::*}
        add "ur trashhhh" to {_deathMessages::*}
        add "min aura" to {_deathMessages::*}
        add "NPC type shi" to {_deathMessages::*}
        add "free elo" to {_deathMessages::*}
        add "maybe try smth else?" to {_deathMessages::*}
        add "even the bots fight better" to {_deathMessages::*}
        add "cooked." to {_deathMessages::*}
        add "afk ahh" to {_deathMessages::*}
        add "..." to {_deathMessages::*}
        add "consider uninstalling" to {_deathMessages::*}
        add "the end" to {_deathMessages::*}
        add "how did u even win the sperm race vro" to {_deathMessages::*}
        add "holy shit that sucked" to {_deathMessages::*}
        add "Skill issue." to {_deathMessages::*}
        add "git gud" to {_deathMessages::*}
        add "stage 4 terminal skill issue" to {_deathMessages::*}
        add "my grandma better than u" to {_deathMessages::*}
