on damage:
    if world is "lobby":
        if damage cause is fall:
            cancel event

on any click:
    if world is "lobby":
        if {debug.%player%} is not true:
            cancel event

on block break:
    if world is "KitPvP":
        if {debug.%player%} is not true:
            if y coord of block > 149:
                cancel event