on join:
    if {debug.%player%} is true:
        delete {debug.%player%}
        send "&7Debug is disabled due to you leaving the server."
    delete {debug.%player%.code}

command /debug [<text>]:
    trigger:
        if {debug.%player%} is not true:
            if {debug.%player%.code} is set:
                if arg-1 is set:
                    if arg-1 is "%{debug.%player%.code}%":
                        set {debug.%player%} to true
                        send "<#ff0000>&lDebug &r&8» &r&aDebug has been enabled."
                        delete {debug.%player%.code}
                        broadcast "&7%player% has entered debug mode."
                    else:
                        kick player due to "dont fucking try to enter debug without permission."
                        broadcast "&7%player% tried to enter debug without permission."
                else:
                    send "&4Do /debug <code>"
            else:
                if player has permission "skript.debug":
                    set {debug.%player%} to true
                    send "<#ff0000>&lDebug &r&8» &r&aDebug has been enabled."
                    delete {debug.%player%.code}
                    broadcast "&7%player% has entered debug mode."
                else:
                    set {debug.%player%.code} to a random integer between 0 and 999999
                    send "&a--------------------%{debug.%player%.code}%---------------------" to console
                    send "&aThis is the code for enabling debug to %player%" to console
                    loop all players:
                        if loop-player has permission "skript.debug":
                            send "<#ff0000>&lDebug &r&8» &r&a%player% wants to enter debug mode, code: %{debug.%player%.code}%" to loop-player
                    send "<#ff0000>&lDebug &r&8» &r&aA code has been sent to the console and all op players, ask for the code to enable debug." to player
        else:
            send "<#ff0000>&lDebug &r&8» &r&aDebug has been disabled."
            broadcast "&7%player% has left debug mode."
            delete {debug.%player%}

on command:
    if command contains "debug":
        if command is not "debug":
            if {debug.%player%} is not true: 
                if sender is console:
                    stop
                send "&r&4You're not allowed to use this command."
                cancel event
                
command /debug.whatblockisthis:
    trigger:
        send player's targeted block to player

command /debug.whatitemisthis:
    trigger:
        send player's tool to player

command /debug.whatworldamiin:
    trigger:
        send player's world to player

command /debug.whatlightlevelisthisblock:
    trigger:
        send light level of player's targeted block to player

command /debug.reload:
    trigger:
        execute player command "/sk reload debug.sk"

            
on damage with priority lowest:
    if event is canceled:
        stop
    wait 1 tick
    if {debug.%attacker%} is true:
        send "&r&7Tool:&r<#ff0000> %attacker's tool%" to attacker
        send "&r&7Raw damage:&r<#ff0000> %damage%" to attacker
        send "&r&7Final damage:&r<#ff0000> %final damage%" to attacker
        send "&r&7Health remaining:&r<#ff0000> %victim's health%" to attacker

        set {_totems} to amount of totem of undying in victim's inventory

        if victim's offhand item is totem of undying: 
            add amount of victim's offhand item to {_totems}

        send "&r&7Totems:&r&a %{_totems}%" to attacker
        send "&r&7Absorption:&r&6 %victim's absorption amount / 2%" to attacker
    if {debug.%victim%} is true:
        if attacker's tool is set:
            send "&r&7Tool:&r<#ff0000> %attacker's tool%" to victim
        send "&r&7Raw damage:&r<#ff0000> %damage%" to victim
        send "&r&7Final damage:&r<#ff0000> %final damage%" to victim
        send "&r&7Health remaining:&r<#ff0000> %victim's health%" to victim

        set {_totems} to amount of totem of undying in victim's inventory

        if victim's offhand item is totem of undying: 
            add amount of victim's offhand item to {_totems}

        send "&r&7Totems:&r&a %{_totems}%" to victim
        send "&r&7Absorption:&r&6 %victim's absorption amount / 2%" to victim

command /debug.ghostblockify:
    trigger:
        set {_loc} to player's target block's location
        make player see {_loc} as air

command /debug.unghostblockify:
    trigger:
        set {_loc} to player's target block's location
        make player see {_loc} as block at {_loc}

command /debug.falldis <number>:
    trigger:
        set player's fall distance to arg-1
        send "&r&7Your fall distance has been set to %arg-1%"

command /debug.whatismyuuid [<player>]:
    trigger:
        if arg-1 is set:
            send arg-1's uuid
        else:
            send player's uuid

command /debug.testvar <text>:
    trigger:
        send "%{%arg-1%}%" to player


command /debug.cnbtcheck:
    trigger:
        send "%custom nbt of player's tool%" to player

import:
    org.bukkit.event.player.PlayerItemHeldEvent

on PlayerItemHeldEvent with priority highest:
    set {_player} to event.getPlayer()
    set {lastitem::%uuid of {_player}%} to event.getPreviousSlot()
    wait 1 ticks
    delete {lastitem::%uuid of {_player}%}

on click:
    if {lastitem::%uuid of player%} is set:
        if {debug.%player%} is true: 
            send "&aAttribute swap detected."

command /debug.forceattack <player>:
    trigger:
        make player attack arg-1

command /debug.isbroblocking:
    trigger:
        if player's targeted entity is blocking:
            send "ye"
        else:
            send "nah"