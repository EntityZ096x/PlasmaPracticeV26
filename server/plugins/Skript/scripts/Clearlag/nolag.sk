on spawn:
    if spawn reason is not natural:
        stop
    loop all entities:
        if loop-entity is not a player:
            if loop-entity is not a item:
                add 1 to {_e}
    if {_e} >= 0:
        cancel event

on right click on entity:
    set {interacted::%uuid of event-entity%} to true

on damage:
    if attacker is a player:
        set {interacted::%uuid of victim%} to true

command /fucklag:
    trigger:
        loop all entities:
            loop-entity is not a player
            loop-entity is not a villager
            if {interacted::%uuid of loop-entity%} is not set:
                delete loop-entity
        broadcast "&r&d&lClearlag &r&8»&r &aCleared all wild mobs & items."
