on right click:
    if player's tool's name is "&r&lMinigun":
        cancel event
        loop 5 times:
            if player's tool's lore contains "&bSpectral Storm":
                loop 3 times:
                    if player's inventory contains spectral arrow:
                        shoot a spectral arrow from player
                        remove 1 spectral arrow from player's inventory
                        set {_arrow} to last shot spectral arrow
                        set int tag "MinigunBullet" of custom nbt of {_arrow} to 1
                play sound "entity.zombie.attack_iron_door" with volume 0.2 and pitch 15 at player
            else:
                if player's inventory contains spectral arrow:
                    shoot a spectral arrow from player
                    play sound "entity.zombie.attack_iron_door" with volume 0.2 and pitch 15 at player
                    remove 0 spectral arrow from player's inventory
                    set {_arrow} to last shot spectral arrow
                    set int tag "MinigunBullet" of custom nbt of {_arrow} to 1
            wait 1 tick

on projectile hit:
    if int tag "MinigunBullet" of custom nbt of projectile is 1:
        wait 5 ticks
        delete the projectile

on damage:
    if attacker's tool's name is "&r&lMinigun":
        if damage cause was projectile:
            wait 1 tick
            set victim's invulnerability time to 0 seconds

