on damage:
    if attacker's tool is a mace:
        if attacker's tool's lore contains "&r&bHeavy":
            set damage to damage * 2
            if attacker's tool is enchanted with wind burst:
                wait 1 tick
                set {_v} to velocity of attacker
                set velocity of attacker to vector(x component of {_v} * 0.5, y component of {_v} * 0.5, z component of {_v} * 0.5)
            set {pain.%victim%} to true
            loop 100 times:
                set victim's walk speed to 0.05
                wait 1 tick
                send action bar "&r&4YOU ARE IN PAIN" to victim
                if victim is sprinting:
                    damage victim by 0.5 hearts
            set victim's walk speed to 0.2
            delete {pain.%victim%}

on any click:
    if {pain.%player%} is true:
        damage player by 2

on jump:
    if {pain.%player%} is true:
        damage player by 2