on damage:
    if attacker's tool is a mace:

        set {_power} to 0
        set {_v} to victim

        if string tag "mythical_item" of custom nbt of attacker's tool is "heavy_mace":
            set {_power} to 1
        else if attacker's tool's lore contains "&r&bHeavy":
            set {_power} to 0.333333

        if {_power} is 0:
            stop

        if attacker does not have potion effect of strength:
            cancel event
            send action bar "<#ff0000>Your mace is too heavy to use!" to attacker
            stop

        if {_v} is blocking:
            break shield of {_v}
            cancel event
            stop

        if fall distance of attacker < 2:
            stop

        set damage to damage * (1 + {_power} * 1)

        if attacker's tool is enchanted with wind burst:
            wait 1 tick
            set {_v} to velocity of attacker
            set velocity of attacker to vector(x component of {_v}, y component of {_v} * (0.5 ^ {_power}), z component of {_v})

        if {_power} is 1:
            apply bad luck 2 to attacker for 5 seconds
        else:
            apply bad luck 1 to attacker for 5 seconds

on damage:
    if damage cause is fall:
        if victim's tool is a mace:
            set {_power} to 0

            if string tag "mythical_item" of custom nbt of victim's tool is "heavy_mace":
                set {_power} to 1
            else if victim's tool's lore contains "&r&bHeavy":
                set {_power} to 0.333333

            if {_power} > 0:
                set damage to damage * (1 + {_power})

on player walk:
    if player has bad luck:
        set {_p} to potion tier of bad luck of player
        send "%{_p}%" 
        if player is sprinting:
            damage player by 0.5 * {_p} hearts with fake cause starvation
        else:
            damage player by 0.25 * {_p} hearts with fake cause starvation

on any click:
    if player has bad luck:
        damage player by 0.5 * {_p} hearts with fake cause starvation