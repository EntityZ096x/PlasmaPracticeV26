on damage:
    if attacker is not victim:
        if attacker is a player:
            if attacker's tool is a mace:
                set {_power} to 0

                if string tag "mythical_item" of custom nbt of attacker's tool is "lightweight_mace":
                    set {_power} to 1
                else if attacker's tool's lore contains "&r&bLightweight":
                    set {_power} to 0.333

                if {_power} > 0:
                    set gliding of attacker to false

                    if fall distance of attacker < 2:
                        set fall distance of attacker to 2

                    set damage to damage * (1 - (0.5 * {_power}))

                    set {_duration} to 5 seconds * {_power}
                    apply speed to attacker for {_duration}

                    if attacker's tool is enchanted with wind burst:
                        wait 1 tick
                        set {_v} to velocity of attacker
                        set velocity of attacker to vector(x component of {_v} * (1 + {_power}), y component of {_v} * (1 + (0.5 * {_power})), z component of {_v} * (1 + {_power}))
on damage:
    if damage cause is fall:
        if victim is a player:
            if victim's tool is a mace:
                set {_power} to 0

                if string tag "mythical_item" of custom nbt of victim's tool is "lightweight_mace":
                    set {_power} to 1
                else if victim's tool's lore contains "&r&bLightweight":
                    set {_power} to 0.333

                if {_power} > 0:
                    set damage to damage * (1 - (0.5 * {_power}))