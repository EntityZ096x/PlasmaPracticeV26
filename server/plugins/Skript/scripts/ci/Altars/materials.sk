function AltarMaterials(i: text) :: objects:
    delete {_m::*}

    if {_i} is "heavy_mace":
        set {_m::*} to 1 mace, 5 netherite blocks

    else if {_i} is "lightweight_mace":
        set {_m::*} to 1 mace, 3 enchanted book, 256 breeze rods
        add wind burst 3 to stored enchantments of {_m::2}

    return {_m::*}

function AltarItemNames(i: text) :: object:
    delete {_itemname}

    if {_i} is "heavy_mace":
        set {_itemname} to "<#ff0000>&k&l|||&r<#ff0000> Maelstrom &k&l|||"

    else if {_i} is "lightweight_mace":
        set {_itemname} to "&b&k&l|||&r&b Zephyr &k&l|||"

    return {_itemname}

function AltarTimes(i: text) :: object:
    delete {_t}
    set {_t} to 15

    return {_t}

on load:
    delete {altar.entries::*}
    add "heavy_mace" to {altar.entries::*}
    add "lightweight_mace" to {altar.entries::*}