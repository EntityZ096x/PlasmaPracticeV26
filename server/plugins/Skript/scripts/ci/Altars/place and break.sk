function AltarRemoveDisplays(l: location):
    set {_pedLoc} to {_l}
    set {_itemLoc} to {_l}
    set {_holoLoc} to {_l}

    add 1 to y coordinate of {_itemLoc}
    add 2.5 to y coordinate of {_holoLoc}

    # Remove pedestal display
    loop all item displays in radius 0.3 around {_pedLoc}:
        kill loop-entity

    # Remove floating item display
    loop all item displays in radius 0.3 around {_itemLoc}:
        kill loop-entity

    # Remove hologram
    loop all text displays in radius 0.3 around {_holoLoc}:
        kill loop-entity


function AltarSpawnDisplays(l: location, i: text):
    # Remove old displays first to prevent duplicates
    AltarRemoveDisplays({_l})

    set {_pedestalItem} to lodestone
    set item model of {_pedestalItem} to "minecraft:altar_pedestal"

    spawn item display at {_l}:
        set item of entity to {_pedestalItem}
        set billboard of entity to fixed

    # Determine the displayed item
    if {_i} is "heavy_mace":
        set {_item} to a mace
        set item model of {_item} to "minecraft:heavy_mace"
        set {_HoloItem} to "<#ff0000>Maelstrom<reset>"

    else if {_i} is "lightweight_mace":
        set {_item} to a mace
        set item model of {_item} to "minecraft:lightweight_mace"
        set {_HoloItem} to "&bZephyr<reset>"

    else:
        stop

    set {_itemloc} to {_l}
    add 1 to y coordinate of {_itemloc}

    spawn item display at {_itemloc}:
        set item of entity to {_item}
        set item display transform of entity to ground

    set {_holoText} to "&f%{_HoloItem}% <gradient:#9E00FF:#FF00B3>Altar</gradient>"

    set {_holoLoc} to {_l}
    add 2.5 to y coordinate of {_holoLoc}

    spawn text display at {_holoLoc}:
        set text of entity to {_holoText}
        set billboard of entity to center

function AltarClearRitual(l: location):
    set {_p} to {altar.crafter::%{_l}%}

    if {_p} is set:
        delete {altar.crafting::%{_p}%}

    delete {altar.interrupted::%{_l}%}
    delete {altar.inprogress::%{_l}%}
    delete {altar.crafter::%{_l}%}


function AltarRemove(l: location):
    AltarRemoveDisplays({_l})

    delete {altar.locations::%{_l}%}
    delete {altar.pedestals::%{_l}%::*}
    delete {altar.pedestals::%{_l}%}

    set block at {_l} to air

command /altar.create <text>:
    trigger:

        set {_loc} to player's target block
        add 1 to y coordinate of {_loc}

        if {altar.locations::%{_loc}%} is set:
            send "<#ff0000>There is already an altar here!"
            stop

        if {altar.entries::*} doesn't contain arg-1:
            send "<#ff0000>Unknown altar item!"
            stop

        set block at {_loc} to barrier

        set {altar.locations::%{_loc}%} to {_loc}
        set {altar.pedestals::%{_loc}%::craftableitem} to arg-1

        AltarSpawnDisplays({_loc}, arg-1)

        send "<#00ff00>Altar created successfully!"

every tick:
    loop {altar.locations::*}:

        set {_loc} to loop-value

        set {_itemloc} to {_loc}
        add 1 to y coordinate of {_itemloc}

        loop all item displays in radius 0.3 around {_itemloc}:
            set {_yaw} to yaw of loop-entity
            add -3 to {_yaw}
            set yaw of loop-entity to {_yaw}

on break:
    set {_loc} to location of block

    if {altar.locations::%{_loc}%} is set:
        cancel event

        if {altar.inprogress::%{_loc}%} is set:
            set {altar.interrupted::%{_loc}%} to true

        AltarRemove({_loc})

        send "<#ff0000>Altar removed!" to player


command /altar.cleanup:
    permission: op
    trigger:

        loop {altar.locations::*}:

            set {_loc} to loop-value

            if {altar.inprogress::%{_loc}%} is set:
                # Let the ritual loop handle the refund and boss bar.
                set {altar.interrupted::%{_loc}%} to true

                # Remove the physical altar, but preserve ritual state.
                AltarRemoveDisplays({_loc})

                delete {altar.locations::%{_loc}%}
                delete {altar.pedestals::%{_loc}%::*}
                delete {altar.pedestals::%{_loc}%}

                set block at {_loc} to air

            else:
                AltarRemove({_loc})

        send "<#00ff00>All registered altars cleaned up!"

on stop:
    loop {altar.locations::*}:
        set {_loc} to loop-value

        if {altar.inprogress::%{_loc}%} is set:
            set {_item} to {altar.pedestals::%{_loc}%::craftableitem}
            set {_m::*} to AltarMaterials({_item})

            AltarClearRitual({_loc})

            set {_dropLoc} to {_loc}
            add 0.5 to x coord of {_dropLoc}
            add 1.5 to y coord of {_dropLoc}
            add 0.5 to z coord of {_dropLoc}

            drop {_m::*} at {_dropLoc}

            broadcast "<#ff0000>An altar ritual was interrupted because of a server restart!"
